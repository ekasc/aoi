{
  "expo": {
    "name": "aoi",
    "slug": "aoi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aoi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ekasc.aoi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ekasc.aoi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F2EA",
          "dark": {
            "backgroundColor": "#13110E"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      "expo-notifications",
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aoi uses your position only while you have location sharing turned on, so your partner can see you're on your way.",
          "locationAlwaysAndWhenInUsePermission": "Aoi shares your position while Live sharing is on, so your partner knows you'll be home soon. You can turn it off at any time.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e4d0943-443c-4f35-8e32-0e0b780886a5"
      }
    },
    "owner": "aoi-app"
  }
}
