{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi.local/schemas/simulation-bundle.v1.schema.json",
  "title": "Aoi MiroFish lab simulation bundle",
  "description": "Normalized output from a live MiroFish run or a clearly labelled offline dry-run fixture. A fixture bundle must never set mode=live or live=true.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "live", "provenance", "observations", "report"],
  "properties": {
    "schemaVersion": { "const": "aoi-simulation-bundle/1" },
    "mode": { "enum": ["live", "dry_run_fixture", "local_oasis"] },
    "live": { "type": "boolean" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulation_id",
        "aoi_commit",
        "mirofish_commit",
        "seed_version",
        "generated_at",
        "label"
      ],
      "properties": {
        "simulation_id": { "type": "string", "minLength": 1 },
        "aoi_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "mirofish_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
        "seed_version": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "minLength": 10 },
        "label": { "type": "string", "minLength": 10 },
        "base_url": { "type": "string" },
        "model": { "type": "string" },
        "rounds_run": { "type": "integer", "minimum": 0 },
        "repeat_index": { "type": "integer", "minimum": 0 },
        "backend": { "type": "string" },
        "couple_id": { "type": "string" },
        "focus": { "type": ["string", "null"] },
        "warning": { "type": "string" }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "round", "platform", "agent_id", "persona_id", "text", "theme", "signals"],
        "properties": {
          "id": { "type": "string", "pattern": "^obs-[0-9]{3}$" },
          "source": { "enum": ["post", "comment", "interview", "report"] },
          "round": { "type": "integer", "minimum": 0 },
          "platform": { "enum": ["twitter", "reddit", "interview", "report"] },
          "agent_id": { "type": "integer", "minimum": 0 },
          "persona_id": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "theme": { "enum": ["A", "B", "C", "D", "E", "F"] },
          "signals": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "findings"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "findings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
