{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aoi.local/schemas/coverage.v1.schema.json",
  "title": "Aoi scenario coverage analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "aoiCommit", "generatedAt", "summary", "scenarios"],
  "properties": {
    "schemaVersion": { "const": "aoi-coverage/1" },
    "aoiCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "generatedAt": { "type": "string", "minLength": 10 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "partial", "not_covered", "not_automatable", "invalid"],
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "not_covered": { "type": "integer", "minimum": 0 },
        "not_automatable": { "type": "integer", "minimum": 0 },
        "invalid": { "type": "integer", "minimum": 0 }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "evidence", "notes"],
        "properties": {
          "id": { "type": "string", "pattern": "^AOI-SIM-[0-9]{3}$" },
          "level": {
            "enum": ["covered", "partial", "not_covered", "not_automatable", "invalid"]
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 400 }
          },
          "notes": { "type": "string", "maxLength": 800 }
        }
      }
    }
  }
}
