# App auth mode
# true  -> local stub auth (default)
# false -> real backend OAuth/session APIs
EXPO_PUBLIC_AUTH_STUB_MODE=true

# Backend API base URL (required when AUTH_STUB_MODE=false)
EXPO_PUBLIC_AUTH_API_BASE_URL=http://localhost:8080

# OAuth client IDs (required when AUTH_STUB_MODE=false)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=replace_me_google_ios_client_id
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=replace_me_google_android_client_id
EXPO_PUBLIC_APPLE_ANDROID_CLIENT_ID=replace_me_apple_android_service_id
