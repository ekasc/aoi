    "expo-blur": "^58.0.5",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "^58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "^58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "^58.0.10",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-print": "~58.0.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "^58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "moti": "^0.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.16.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.12",
    "@babel/traverse": "^7.29.12",
    "@babel/types": "^7.29.11",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@expo/ngrok": "^4.1.3",
    "@hono/node-server": "^2.1.6",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "happy-dom": "^21.0.4",
    "react-test-renderer": "19.1.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12",
    "ws": "^8.22.1"
  },
  "private": true
}
