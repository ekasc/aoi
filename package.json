    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.7",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "^0.1.8",
