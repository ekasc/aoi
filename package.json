{
  "name": "aoi",
  "main": "index.js",
  "version": "1.0.0",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "release:check": "node --experimental-strip-types scripts/check-release.mjs",
    "eas-build-post-install": "node --experimental-strip-types scripts/check-release.mjs --eas",
    "start": "node scripts/start-dev.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "a11y:audit": "node scripts/a11y-audit.mjs",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:targets": "node scripts/dev-agent.mjs targets",
    "dev:logs": "node scripts/dev-agent.mjs logs",
    "dev:eval": "node scripts/dev-agent.mjs eval",
    "dev:screenshot": "node scripts/dev-agent.mjs screenshot",
    "dev:select": "node scripts/dev-agent.mjs select",
    "dev:report": "node scripts/dev-agent.mjs report",
    "dev:reload": "node scripts/dev-agent.mjs reload",
    "sim-nav": "node scripts/sim-nav.mjs",
    "sim-press": "node scripts/sim-press.mjs",
    "test:unit": "vitest run --maxWorkers 1 --project unit-app --project unit-shared --project unit-api",
    "test:unit:watch": "vitest --maxWorkers 1 --project unit-app --project unit-shared --project unit-api",
    "test:integration": "vitest run --maxWorkers 1 --project integration --project workers",
    "test:integration:watch": "vitest --maxWorkers 1 --project integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:mobile:stub": "command -v maestro >/dev/null || (echo \"Maestro is not installed. Install it (https://maestro.mobile.dev) and boot an emulator/device, then rerun.\" >&2; exit 1); maestro test e2e/maestro/auth-stub-smoke.yaml",
    "test:e2e:mobile": "command -v maestro >/dev/null || (echo \"Maestro is not installed. Install it (https://maestro.mobile.dev) and boot an emulator/device, then rerun.\" >&2; exit 1); maestro test e2e/maestro/",
    "test:e2e:notifications": "node scripts/e2e-notifications.mjs",
    "dev:profile": "node scripts/dev-agent.mjs profile",
    "mirofish": "node tools/mirofish-lab/src/quickstart.mjs",
    "mirofish:demo": "node tools/mirofish-lab/src/quickstart.mjs --demo",
    "mirofish:live": "node tools/mirofish-lab/src/quickstart.mjs --live",
    "mirofish:check": "node tools/mirofish-lab/src/quickstart.mjs --check",
    "mirofish-lab": "node tools/mirofish-lab/src/cli.mjs",
    "mirofish-lab:check": "node tools/mirofish-lab/src/cli.mjs check",
    "mirofish-lab:seeds": "node tools/mirofish-lab/src/cli.mjs seeds",
    "mirofish-lab:personas": "node tools/mirofish-lab/src/cli.mjs personas",
    "mirofish-lab:run": "node tools/mirofish-lab/src/cli.mjs run",
    "mirofish-lab:oasis": "node tools/mirofish-lab/src/cli.mjs run --mode oasis",
    "mirofish-lab:proxy": "node tools/mirofish-lab/src/opencode-proxy.mjs",
    "mirofish-lab:extract": "node tools/mirofish-lab/src/cli.mjs extract",
    "mirofish-lab:coverage": "node tools/mirofish-lab/src/cli.mjs coverage",
    "mirofish-lab:execute": "node tools/mirofish-lab/src/cli.mjs execute",
    "mirofish-lab:report": "node tools/mirofish-lab/src/cli.mjs report",
    "mirofish-lab:baseline": "node tools/mirofish-lab/src/cli.mjs baseline",
    "mirofish-lab:baseline:llm": "node tools/mirofish-lab/src/cli.mjs baseline-llm",
    "mirofish-lab:doctor": "node tools/mirofish-lab/src/cli.mjs doctor",
    "mirofish-lab:all": "node tools/mirofish-lab/src/cli.mjs all",
    "mirofish-lab:test": "node --test tools/mirofish-lab/tests/*.test.mjs"
  },
  "dependencies": {
    "@aoi/shared": "workspace:*",
    "@babel/runtime": "^7.29.10",
    "@expo/metro-runtime": "^58.0.17",
    "@expo/ui": "~58.0.27",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.2.0",
    "@scure/bip39": "^2.4.0",
    "@shopify/react-native-skia": "^2.14.0",
    "babel-preset-expo": "~58.0.24",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
