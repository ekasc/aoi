# Aoi API Server — Environment Variables

# Postgres connection string
# Example: postgres://user:password@localhost:5432/aoi
DATABASE_URL=postgres://localhost:5432/aoi

# JWT signing secret (generate: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-secret

# CORS allowed origin (set to your frontend URL in production)
CORS_ORIGIN=*

# Server port
PORT=8080
