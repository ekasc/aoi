{
  "name": "@aoi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:legacy": "tsx watch src/index.ts",
    "start": "node src/index.ts",
    "build:cloudflare": "vite build",
    "deploy:cloudflare:dry": "vite build && wrangler deploy --dry-run",
    "deploy:dev": "AOI_DEPLOY_ENV=dev vite build && wrangler deploy",
    "deploy:production": "AOI_DEPLOY_ENV=prod vite build && wrangler deploy",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:generate:d1": "drizzle-kit generate --config drizzle-d1.config.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:local": "wrangler d1 migrations apply aoi-db-preview --local --config wrangler.migrations.jsonc",
    "db:migrate:dev": "wrangler d1 migrations apply aoi-db-preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply aoi-db --remote",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aoi/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-openapi": "^0.19.4",
    "@hono/zod-validator": "^0.4.0",
    "@workos-inc/node": "^10.0.0",
    "better-auth": "1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.40.0",
    "effect": "^3.22.1",
    "file-type": "22.0.1",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.5",
    "sharp": "0.35.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.43.0",
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@img/sharp-wasm32": "^0.35.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/sharp": "^0.32.0",
    "@types/uuid": "^10.0.0",
    "better-sqlite3": "12.11.1",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.107.0"
  }
}
